# Copia este archivo a .env.local y llena los valores. NUNCA subas .env.local (está en .gitignore).

# Token privado de HubSpot (private app). Obligatorio. Solo lo lee el servidor.
HUBSPOT_TOKEN=pat-na1-xxxxxxxx

# Contraseña compartida para entrar. En producción es OBLIGATORIA: sin ella el sitio responde 503.
# En local, si se deja vacía, el sitio queda abierto.
ADOPTION_PASSWORD=

# Secreto del cron diario (Vercel lo envía solo como "Authorization: Bearer ..."). Obligatorio en producción.
CRON_SECRET=

# Token del agente para subir retención y activación a /api/connect/snapshot (generado desde Metabase).
CONNECT_TOKEN=

# --- Solo en producción (Vercel KV), para que los datos persistan entre visitas ---
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
