# Copia este archivo a .env.local y llena los valores.

# Token privado de HubSpot (private app). Obligatorio.
HUBSPOT_TOKEN=pat-na1-xxxxxxxx

# Contraseña compartida para entrar al dashboard.
# Si se deja vacía, el dashboard queda ABIERTO (solo recomendable en local).
ADOPTION_PASSWORD=

# Secreto para proteger el endpoint /api/refresh del cron (opcional pero recomendado en prod).
REFRESH_SECRET=

# --- Solo en producción (Vercel KV), para que los datos persistan entre visitas ---
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
